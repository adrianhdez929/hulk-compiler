
function fibonacci(x:Int) {
  if (x > 0) {
    let x1 = x;  
    let x2 = x;
    let v1 = fibonacci(x1); 
    let v2 = fibonacci(x2);
    v1 + v2;  // Sumamos los resultados
  }
  else {
    let result = 1;
    result;  // Devolvemos el resultado
  };
}
type Point {
  x = 3;
}
type OtroType {
  y = "25";
}
{
  function fibonacci( x : Int) => fibonacci(x-1) + fibonacci(x-2);
}
