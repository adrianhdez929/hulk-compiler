{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "Grammar/grammar.cpp",
                "Grammar/production.cpp",
                "Grammar/symbol.cpp",
                "Grammar/sentence.cpp",
                "Automata/dfa.cpp",
                "Automata/nfa.cpp",
                "Automata/utils/ContainerSet.cpp",
                "Automata/utils/aut_manipulation.cpp",
                "Automata/operations/operations.cpp",
                "Automata/state.cpp",
                "Parser/Item.cpp",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}